<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_autonomo" model="ir.module.category">
        <field name="name">Autonomo</field>
        <field name="sequence">35</field>
    </record>

    <record id="res_groups_privilege_autonomo" model="res.groups.privilege">
        <field name="name">Autonomo</field>
        <field name="category_id" ref="module_category_autonomo"/>
        <field name="sequence">35</field>
    </record>

    <record id="group_autonomo_user" model="res.groups">
        <field name="name">Autonomo Usuario</field>
        <field name="privilege_id" ref="res_groups_privilege_autonomo"/>
    </record>

    <record id="group_autonomo_manager" model="res.groups">
        <field name="name">Autonomo Responsable</field>
        <field name="privilege_id" ref="res_groups_privilege_autonomo"/>
        <field name="implied_ids" eval="[(4, ref('group_autonomo_user'))]"/>
    </record>

    <record id="group_autonomo_accounting" model="res.groups">
        <field name="name">Autonomo Contabilidad</field>
        <field name="privilege_id" ref="res_groups_privilege_autonomo"/>
        <field name="implied_ids" eval="[(4, ref('group_autonomo_manager'))]"/>
    </record>

    <record id="group_autonomo_ai_reviewer" model="res.groups">
        <field name="name">Autonomo Revisor IA</field>
        <field name="privilege_id" ref="res_groups_privilege_autonomo"/>
        <field name="implied_ids" eval="[(4, ref('group_autonomo_user'))]"/>
    </record>

    <record id="group_autonomo_admin" model="res.groups">
        <field name="name">Autonomo Administrador</field>
        <field name="privilege_id" ref="res_groups_privilege_autonomo"/>
        <field name="implied_ids" eval="[(4, ref('group_autonomo_accounting')), (4, ref('group_autonomo_ai_reviewer'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>
</odoo>
