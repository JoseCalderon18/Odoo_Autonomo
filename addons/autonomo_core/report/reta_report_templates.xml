<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_autonomo_reta_profile">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <style>
                            table.table, table.table tr, table.table th, table.table td { border: 0 !important; box-shadow: none !important; }
                            table.table th, table.table td { padding: 5px 0; }
                            table.table td:last-child { font-weight: 700; }
                            h4 { margin-top: 18px; padding-bottom: 6px; border-bottom: 1px solid #dddddd; }
                        </style>
                        <h2>Ficha RETA interna</h2>
                        <p><strong>Empresa:</strong> <span t-field="doc.company_id.name"/> | <strong>Estado:</strong> <span t-field="doc.reta_status"/></p>
                        <p><strong>Fecha:</strong> <span t-field="doc.write_date"/> | <strong>Usuario:</strong> <span t-esc="env.user.name"/></p>
                        <table class="table table-sm">
                            <tr><td>Alta RETA</td><td><span t-field="doc.reta_start_date"/></td></tr>
                            <tr><td>IAE</td><td><span t-field="doc.iae_code"/></td></tr>
                            <tr><td>CNAE</td><td><span t-field="doc.cnae_code"/></td></tr>
                            <tr><td>Rendimientos netos estimados</td><td><span t-field="doc.estimated_annual_net_returns"/></td></tr>
                            <tr><td>Base seleccionada</td><td><span t-field="doc.selected_contribution_base"/></td></tr>
                            <tr><td>Tramo</td><td><span t-field="doc.contribution_bracket_code"/></td></tr>
                            <tr><td>Mutua</td><td><span t-field="doc.mutual_insurance_name"/></td></tr>
                        </table>
                        <p class="text-muted">No presenta automaticamente altas, bajas ni modificaciones RETA. Requiere revision humana.</p>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
