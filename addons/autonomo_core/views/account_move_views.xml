<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_autonomo_core" model="ir.ui.view">
        <field name="name">account.move.form.autonomo.core</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_date']" position="after">
                <field name="operation_date"/>
                <field name="activity_id"/>
                <field name="tax_document_kind"/>
                <field name="tax_review_state"/>
            </xpath>
            <xpath expr="//sheet/notebook" position="inside">
                <page string="Autonomo">
                    <group>
                        <group>
                            <field name="tax_period_id"/>
                            <field name="income_expense_book_state"/>
                            <field name="book_locked"/>
                            <field name="effective_payment_date"/>
                        </group>
                        <group>
                            <field name="source_attachment_id"/>
                            <field name="document_sha256"/>
                            <field name="electronic_invoice_uuid"/>
                            <field name="electronic_invoice_status"/>
                        </group>
                    </group>
                </page>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='account_id']" position="after">
                <field name="activity_id"/>
                <field name="tax_category_id"/>
                <field name="irpf_deductible_percent"/>
                <field name="vat_deductible_percent"/>
                <field name="deductibility_review_required"/>
            </xpath>
        </field>
    </record>
</odoo>
