<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_autonomo_dashboard" model="ir.actions.act_window">
        <field name="name">Panel autonomo</field>
        <field name="res_model">autonomo.submission</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', 'in', ['draft', 'incomplete', 'review', 'ready'])]</field>
