<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_order_form_autonomo_quotes" model="ir.ui.view">
        <field name="name">purchase.order.form.autonomo.quotes</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_ref']" position="after">
                <field name="autonomo_sale_order_id"/>
            </xpath>
            <xpath expr="//field[@name='order_line']//list//field[@name='product_id']" position="after">
                <field name="autonomo_quote_material_line_id" optional="show"/>
                <field name="autonomo_sale_order_id" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>
