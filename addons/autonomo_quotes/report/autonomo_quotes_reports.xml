        <field name="report_name">autonomo_quotes.report_autonomo_quote_versions</field>
        <field name="report_file">autonomo_quotes.report_autonomo_quote_versions</field>
        <field name="paperformat_id" ref="autonomo_core.paperformat_autonomo_a4"/>
        <field name="binding_model_id" eval="False"/>
        <!-- Informe privado: no se enlaza al menu Imprimir para evitar enviarlo al cliente. -->
    </record>
</odoo>
