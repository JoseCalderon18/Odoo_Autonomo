<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_autonomo_quote_professional">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <style>
                            table.table th, table.table td { border: 0 !important; box-shadow: none !important; }
                            .autonomo_pdf_title { font-size: 19px; font-weight: 700; margin: 18px 0 12px; padding-bottom: 7px; border-bottom: 1px solid #dddddd; }
                            .autonomo_pdf_grid { width: 100%; border-collapse: separate; border-spacing: 0 10px; }
                            .autonomo_pdf_card { background: #f7f7f7; border-radius: 6px; padding: 12px 14px; vertical-align: top; }
                            .autonomo_pdf_label { color: #555555; font-size: 12px; }
                            .autonomo_pdf_value { font-weight: 700; font-size: 14px; }
                            .autonomo_pdf_line { width: 100%; border-collapse: separate !important; border-spacing: 0 5px !important; }
                            .autonomo_pdf_line, .autonomo_pdf_line tbody, .autonomo_pdf_line tr, .autonomo_pdf_line th, .autonomo_pdf_line td {
                                border: 0 !important;
                                border-top: 0 !important;
                                border-bottom: 0 !important;
                                box-shadow: none !important;
                                background: transparent !important;
                            }
                            .autonomo_pdf_line th, .autonomo_pdf_line td { padding: 3px 0; }
                            .autonomo_pdf_line td:last-child, .autonomo_pdf_line th:last-child { text-align: right; font-weight: 700; }
                        </style>
                        <h2>Presupuesto profesional</h2>
                        <p><strong>Empresa:</strong> <span t-field="doc.company_id.name"/> | <strong>NIF:</strong> <span t-field="doc.company_id.vat"/></p>
                        <p><strong>Referencia:</strong> <span t-field="doc.name"/> | <strong>Cliente:</strong> <span t-field="doc.partner_id.name"/></p>

                        <div class="autonomo_pdf_title">Detalle del trabajo y desplazamiento</div>
                        <table class="autonomo_pdf_grid">
                            <tr t-if="doc.work_address">
                                <td class="autonomo_pdf_card" colspan="3">
                                    <div class="autonomo_pdf_label">Direccion de trabajo</div>
                                    <div class="autonomo_pdf_value"><span t-field="doc.work_address"/></div>
                                </td>
                            </tr>
                            <tr>
                                <td class="autonomo_pdf_card" style="width: 50%;">
                                    <div class="autonomo_pdf_value" style="margin-bottom: 6px;">Mano de obra</div>
                                    <table class="autonomo_pdf_line">
                                        <tr><td>Horas</td><td><span t-field="doc.labor_hours"/></td></tr>
                                        <tr><td>Precio por hora</td><td><span t-field="doc.labor_hour_price"/></td></tr>
                                        <tr><td>Importe</td><td><span t-field="doc.labor_amount"/></td></tr>
                                    </table>
                                </td>
                                <td style="width: 2%;"></td>
                                <td class="autonomo_pdf_card" style="width: 48%;">
                                    <div class="autonomo_pdf_value" style="margin-bottom: 6px;">Materiales y kilometraje</div>
                                    <table class="autonomo_pdf_line">
                                        <t t-set="public_materials" t-value="doc.material_line_ids.filtered('include_in_customer_report')"/>
                                        <tr t-if="doc.client_material_amount and not public_materials"><td>Materiales presupuestados</td><td><span t-field="doc.client_material_amount"/></td></tr>
                                        <tr t-foreach="public_materials" t-as="material">
                                            <td>
                                                <span t-field="material.name"/>
                                                <span t-if="material.quantity"> (<span t-field="material.quantity"/> <span t-field="material.uom_id.name"/>)</span>
                                            </td>
                                            <td><span t-field="material.planned_amount"/></td>
                                        </tr>
                                        <tr><td>Km ida</td><td><span t-field="doc.distance_one_way_km"/></td></tr>
                                        <tr><td>Km totales</td><td><span t-field="doc.distance_total_km"/></td></tr>
                                        <tr><td>Km gratuitos</td><td><span t-field="doc.free_distance_km"/></td></tr>
                                        <tr><td>Km facturables</td><td><span t-field="doc.billable_distance_km"/></td></tr>
                                        <tr><td>Desplazamiento</td><td><span t-field="doc.travel_amount"/></td></tr>
                                    </table>
                                </td>
                            </tr>
                            <tr t-if="doc.fuel_amount or doc.parking_amount or doc.toll_amount or doc.diet_amount or doc.overnight_amount or doc.other_travel_amount">
                                <td class="autonomo_pdf_card" colspan="3">
                                    <div class="autonomo_pdf_value" style="margin-bottom: 6px;">Otros importes de viaje</div>
                                    <table class="autonomo_pdf_line">
                                        <tr t-if="doc.fuel_amount"><td>Combustible</td><td><span t-field="doc.fuel_amount"/></td></tr>
                                        <tr t-if="doc.parking_amount"><td>Aparcamiento</td><td><span t-field="doc.parking_amount"/></td></tr>
                                        <tr t-if="doc.toll_amount"><td>Peajes</td><td><span t-field="doc.toll_amount"/></td></tr>
                                        <tr t-if="doc.diet_amount"><td>Dietas</td><td><span t-field="doc.diet_amount"/></td></tr>
                                        <tr t-if="doc.overnight_amount"><td>Alojamiento</td><td><span t-field="doc.overnight_amount"/></td></tr>
                                        <tr t-if="doc.other_travel_amount"><td>Otros desplazamientos</td><td><span t-field="doc.other_travel_amount"/></td></tr>
                                    </table>
                                </td>
                            </tr>
                        </table>

                        <div class="autonomo_pdf_title">Lineas del presupuesto</div>
                        <table class="autonomo_pdf_line">
                            <thead>
                                <tr><th>Concepto</th><th>Cantidad</th><th>Precio</th><th>Subtotal</th></tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="doc.order_line" t-as="line">
                                    <td><span t-field="line.name"/></td>
                                    <td><span t-field="line.product_uom_qty"/></td>
                                    <td><span t-field="line.price_unit"/></td>
                                    <td><span t-field="line.price_subtotal"/></td>
                                </tr>
                            </tbody>
                        </table>
                        <p style="text-align: right; margin-top: 14px;"><strong>Total:</strong> <span t-field="doc.amount_total"/></p>
                        <p t-if="doc.special_conditions"><strong>Condiciones:</strong> <span t-field="doc.special_conditions"/></p>
                        <p class="text-muted">Documento informativo generado desde Odoo. La revision fiscal o juridica requiere validacion humana cuando proceda.</p>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <template id="report_autonomo_quote_cost_sheet">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Hoja interna de costes</h2>
                        <p><strong>Empresa:</strong> <span t-field="doc.company_id.name"/> | <strong>Referencia:</strong> <span t-field="doc.name"/></p>
                        <table class="table table-sm">
                            <thead><tr><th>Concepto interno</th><th class="text-end">Importe</th></tr></thead>
                            <tbody>
                                <tr><td>Horas de trabajo</td><td class="text-end"><span t-field="doc.labor_hours"/></td></tr>
                                <tr><td>Precio hora</td><td class="text-end"><span t-field="doc.labor_hour_price"/></td></tr>
                                <tr><td>Importe mano de obra</td><td class="text-end"><span t-field="doc.labor_amount"/></td></tr>
                                <tr><td>Materiales mostrados al cliente</td><td class="text-end"><span t-field="doc.client_material_amount"/></td></tr>
                                <tr><td>Desplazamiento</td><td class="text-end"><span t-field="doc.travel_amount"/></td></tr>
                                <tr><td>Coste materiales</td><td class="text-end"><span t-field="doc.estimated_material_cost"/></td></tr>
                                <tr><td>Coste mano de obra</td><td class="text-end"><span t-field="doc.estimated_labor_cost"/></td></tr>
                                <tr><td>Herramientas</td><td class="text-end"><span t-field="doc.estimated_tool_cost"/></td></tr>
                                <tr><td>Subcontratas</td><td class="text-end"><span t-field="doc.estimated_subcontract_cost"/></td></tr>
                                <tr><td>Coste total estimado</td><td class="text-end"><span t-field="doc.estimated_total_cost"/></td></tr>
                                <tr><td>Beneficio estimado</td><td class="text-end"><span t-field="doc.estimated_profit"/></td></tr>
                                <tr><td>Margen</td><td class="text-end"><span t-field="doc.quote_estimated_margin_percent"/>%</td></tr>
                            </tbody>
                        </table>
                        <p class="text-muted">Uso interno. No enviar al cliente salvo decision expresa.</p>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <template id="report_autonomo_quote_measurements">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Informe de mediciones</h2>
                        <p><strong>Referencia:</strong> <span t-field="doc.name"/> | <strong>Cliente:</strong> <span t-field="doc.partner_id.name"/></p>
                        <table class="table table-sm">
                            <thead>
                                <tr><th>Medicion</th><th>Area</th><th>Largo</th><th>Ancho</th><th>Alto</th><th>Cantidad</th><th>UdM</th></tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="doc.measurement_ids" t-as="measurement">
                                    <td><span t-field="measurement.name"/></td>
                                    <td><span t-field="measurement.area"/></td>
                                    <td><span t-field="measurement.length"/></td>
                                    <td><span t-field="measurement.width"/></td>
                                    <td><span t-field="measurement.height"/></td>
                                    <td><span t-field="measurement.quantity"/></td>
                                    <td><span t-field="measurement.uom_id.name"/></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <template id="report_autonomo_quote_versions">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Historial de versiones</h2>
                        <p><strong>Referencia:</strong> <span t-field="doc.name"/> | <strong>Version actual:</strong> <span t-field="doc.quote_version"/></p>
                        <table class="table table-sm">
                            <thead>
                                <tr><th>Version</th><th>Estado</th><th>Total</th><th>Coste</th><th>Beneficio</th><th>Fecha</th><th>Hash</th></tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="doc.quote_version_ids" t-as="version">
                                    <td><span t-field="version.version_number"/></td>
                                    <td><span t-field="version.state_snapshot"/></td>
                                    <td><span t-field="version.amount_total"/></td>
                                    <td><span t-field="version.estimated_total_cost"/></td>
                                    <td><span t-field="version.estimated_profit"/></td>
                                    <td><span t-field="version.snapshot_date"/></td>
                                    <td><span t-field="version.snapshot_hash"/></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
