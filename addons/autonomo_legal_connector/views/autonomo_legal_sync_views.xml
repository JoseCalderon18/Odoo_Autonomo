<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_autonomo_legal_sync_status_list" model="ir.ui.view">
        <field name="name">autonomo.legal.sync.status.list</field>
        <field name="model">autonomo.legal.sync.status</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="source_id"/>
                <field name="boe_identifier"/>
                <field name="sync_type"/>
                <field name="state"/>
                <field name="started_at"/>
                <field name="finished_at"/>
                <field name="records_created"/>
                <field name="records_updated"/>
            </list>
        </field>
    </record>

    <record id="view_autonomo_legal_sync_status_form" model="ir.ui.view">
        <field name="name">autonomo.legal.sync.status.form</field>
        <field name="model">autonomo.legal.sync.status</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="source_id"/>
                        <field name="boe_identifier"/>
                        <field name="sync_type"/>
                        <field name="state"/>
                        <field name="started_at"/>
                        <field name="finished_at"/>
                        <field name="http_status"/>
                        <field name="content_hash"/>
                        <field name="records_created"/>
                        <field name="records_updated"/>
                    </group>
                    <field name="error_message"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_autonomo_legal_sync_status" model="ir.actions.act_window">
        <field name="name">Sincronizaciones BOE</field>
        <field name="res_model">autonomo.legal.sync.status</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
